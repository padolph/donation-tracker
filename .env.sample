# Donation Tracker - Environment Variable Template
# Copy this file to .env.local to configure the local development server.
# NOTE: This file is only for local web/browser development.

# Optional: Bypasses the first-run Setup Wizard. If omitted, the Setup Wizard
# will run on first browser launch and automatically write your password here.
# APP_PASSWORD=your_secure_password

# NextAuth secret key used to encrypt cookies and sign tokens.
# You can generate a secure random secret using: npx auth secret
# AUTH_SECRET=your_generated_secret

# Optional: Override the development database URL.
# If omitted, defaults to "file:./prisma/dev.db".
# DATABASE_URL="file:./prisma/dev.db"
