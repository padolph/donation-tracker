{
  "name": "donation-tracker",
  "version": "1.1.2",
  "description": "Secure, local, offline-first donation tracking application.",
  "author": "Paul Adolph <padolph@gmail.com>",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "electron:tsc": "tsc -p tsconfig.electron.json",
    "desktop:dev": "concurrently \"npm run dev\" \"npm run electron:tsc -- --watch\" \"wait-on tcp:3000 || wait-on tcp:3001 && electron .\"",
    "desktop:build": "npx prisma generate && DATABASE_URL=\"file:\\$(pwd)/prisma/production.db\" npx prisma migrate deploy && DATABASE_URL=\"file:\\$(pwd)/prisma/production.db\" npx prisma db seed && npm run build && npm run electron:tsc && electron-builder"
  },
  "build": {
    "appId": "com.donation-tracker.app",
    "productName": "Donation Tracker",
    "asar": true,
    "asarUnpack": [
      "node_modules/**/*",
      "node_modules/.prisma/**/*",
      "prisma/**/*",
      ".next/**/*",
      "public/**/*",
      "next.config.js"
    ],
    "extraResources": [
      {
        "from": "node_modules/.prisma",
        "to": "app.asar.unpacked/node_modules/.prisma"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "deb"
      ]
    }
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "csv-parse": "^6.2.1",
    "next": "16.2.7",
    "next-auth": "^5.0.0-beta.25",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@swc/core": "^1.15.40",
    "@swc/jest": "^0.2.39",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.19",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^11.0.0",
    "concurrently": "^10.0.3",
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.7",
    "eslint-plugin-security": "^4.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-mock-extended": "^4.0.1",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  }
}